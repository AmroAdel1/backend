<html lang="en">
<%- include("../partials/head.ejs") %>     <!-- dynamic code -->

<body>
  <%- include("../partials/nav.ejs") %>     <!-- doesn't escape characters -->

  <div class="blogs content">
    <h2>All Blogs</h2>

    <% if (blogs.length > 0) { %>
      <% blogs.forEach(blog => { %>
      <a class="single" href="/blogs/<%= blog._id %>">
        <h3 class="title"><%= blog.title %></h3>      <!-- output/access value --> 
        <p class="snippet"><%= blog.snippet %></p>
      </a>
      <% }) %>
    <% } else { %>
      <p>There are no blogs to display...</p>
    <% } %>
    
  </div>

  <%- include("../partials/footer.ejs") %>
</body>
</html>





