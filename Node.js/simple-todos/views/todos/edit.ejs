<!DOCTYPE html>
<html lang="en">
    <%- include('../partials/head', { title: 'Edit ' + todo.title }) %>
<body>
    <%- include('../partials/navbar') %>

    <div class="content">
        <div class="edit-todo">
            <h2>Edit Todo</h2>
            <div class="form-container">
            <form action="/todos/<%= todo._id %>" method="POST">
                <div class="form-group">
                <label for="title">Title *</label>
                <input type="text" id="title" name="title" value="<%= todo.title %>" required>
                </div>

                <div class="form-group">
                <label for="description">Description</label>
                <textarea id="description" name="description"><%= todo.description || '' %></textarea>
                </div>

                <div class="form-group">
                <label for="priority">Priority</label>
                <select id="priority" name="priority">
                    <option value="low" <%= todo.priority === 'low' ? 'selected' : '' %>>Low</option>
                    <option value="medium" <%= todo.priority === 'medium' ? 'selected' : '' %>>Medium</option>
                    <option value="high" <%= todo.priority === 'high' ? 'selected' : '' %>>High</option>
                </select>
                </div>
                
<div class="form-group">
  <input type="hidden" name="completed" value="false">
  <label class="checkbox-wrapper">
    <input type="checkbox" name="completed" value="true" <%= todo.completed ? 'checked' : '' %>>
    <span>Mark as completed</span>
  </label>
</div>

                <div style="display: flex; gap: 10px;">
                <button type="submit" class="btn">Update Todo</button>
                <a href="/todos" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
            </div>
        </div>
    </div>

    <%- include('../partials/footer') %>
</body>
</html>